+describe('a build from changed sources (--source)', () => {
+  const pin = JSON.parse(readFileSync(path.join(ROOT, 'upstream', 'onlyoffice.json'), 'utf8'));
+
+  it('takes one address a person can type', () => {
+    expect(checkSource('github.com/you/fork/tree/v1.2.0')).toBe('github.com/you/fork/tree/v1.2.0');
+    expect(checkSource('https://example.org/src/app-1.2.zip')).toBe('https://example.org/src/app-1.2.zip');
+    for (const bad of ['', 'a b', 'x'.repeat(201), 'a\nb', '<script>', 'say "hi"', undefined]) {
+      expect(() => checkSource(bad as string), String(bad)).toThrow(/--source/);
+    }
+  });
+
+  it("puts it where the app page's notice reads it; none: empty, the notice names this project's tag", async () => {
+    const withSource = await bundleScripts({ pin, version: '0.3.1', source: 'example.org/fork/tree/v1.2.0' });
+    expect(withSource.get('filex/app.js')!.toString('utf8')).toContain('"example.org/fork/tree/v1.2.0"');
+    // the file's own banner says it is a modified build and where its source is
+    for (const [, data] of withSource) {
+      expect(data.toString('utf8').split('\n', 2).join('\n')).toMatch(/^\/\* MODIFIED build of filex-office-editor 0\.3\.1 .*\n \* from changed sources\. Source of this build: example\.org\/fork\/tree\/v1\.2\.0$/);
