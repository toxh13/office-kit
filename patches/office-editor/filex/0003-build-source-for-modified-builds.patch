+    const without = await bundleScripts({ pin, version: '0.3.1' });
+    const app = without.get('filex/app.js')!.toString('utf8');
+    expect(app.startsWith('/* filex-office-editor 0.3.1 - filex/app.js')).toBe(true);
+    expect(app).not.toContain('__APP_SOURCE__');
+    expect(app).not.toContain('example.org');
