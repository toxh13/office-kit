diff --git a/src/app/save-queue.ts b/src/app/save-queue.ts
new file mode 100644
index 0000000000000000000000000000000000000000..59c18412e510413a089613156f706e7e45df932a
--- /dev/null
+++ b/src/app/save-queue.ts
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Part of filex-office-editor, the office editor app for filex (see README.md
+// and NOTICE). Contributed by Office Kit.
+//
+// The app's saves, one at a time. A save asked for while one is under way is
+// that one - but for the person's save asked for during an autosave: it is
+// made after it. The autosave's snapshot may be older than the person's last
+// change, and a host may have kept it apart from the file (config.ts
+// SaveReason), so it does not stand for the save the person asked for.
+
+import type { SaveReason } from './config';
+
+export class SaveQueue {
+  private current: { reason: SaveReason; done: Promise<void> } | null = null;
+  private userNext: Promise<void> | null = null;
+
+  /** `write` makes one save; the queue never runs two at once. */
+  constructor(private readonly write: (reason: SaveReason) => Promise<void>) {}
+
+  /** A save is under way. */
+  get busy(): boolean {
+    return this.current !== null;
+  }
+
+  /** Why the save under way is made, or null. */
+  get reason(): SaveReason | null {
+    return this.current?.reason ?? null;
+  }
+
+  save(reason: SaveReason): Promise<void> {
+    const now = this.current;
+    if (now) {
+      if (reason === 'auto' || now.reason === 'user') return now.done;
+      // The person's save during an autosave: once, after it, whatever it came to.
+      this.userNext ??= now.done
+        .catch(() => {})
+        .then(() => {
+          this.userNext = null;
+          return this.save('user');
+        });
+      return this.userNext;
+    }
+    const done = Promise.resolve()
+      .then(() => this.write(reason))
+      .finally(() => {
+        if (this.current?.done === done) this.current = null;
+      });
+    this.current = { reason, done };
+    return done;
+  }
+}
