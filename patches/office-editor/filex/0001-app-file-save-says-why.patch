@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Tests for filex-office-editor (see README.md and NOTICE).
+//
+// Every save says why it is made (`file.save`'s `reason`, src/app/config.ts
+// SaveReason): "user" for the person's, "auto" for the ten-minute one; and
+// the saves go one at a time, the person's asked for during an autosave made
+// after it (src/app/save-queue.ts).
+import { describe, expect, it } from 'vitest';
+
+import type { FilexApp } from '@brftech/filex-app-ui';
+
+import { coeditApi } from '../src/app/coedit-client';
+import { SAVE_REASONS, saveParams, type SaveReason } from '../src/app/config';
+import { SaveQueue } from '../src/app/save-queue';
+
+describe("file.save's params", () => {
+  it('the document, its type and why, for the opened file', () => {
+    const data = new Uint8Array([1, 2, 3]).buffer;
+    expect(saveParams(data, 'application/x', 'user')).toEqual({ index: 0, data, mime: 'application/x', reason: 'user' });
+    expect(saveParams(data, 'application/x', 'auto')).toEqual({ index: 0, data, mime: 'application/x', reason: 'auto' });
+    expect(SAVE_REASONS).toEqual(['user', 'auto']);
+  });
+
+  it('together, how far into the log it reaches too', () => {
+    const data = new ArrayBuffer(1);
+    expect(saveParams(data, 'm', 'auto', 7)).toEqual({ index: 0, data, mime: 'm', reason: 'auto', through: 7 });
+    expect(saveParams(data, 'm', 'user', 0)).toMatchObject({ through: 0 });
+  });
+
+  it('no other reason', () => {
+    expect(() => saveParams(new ArrayBuffer(1), 'm', 'later' as SaveReason)).toThrow(/user or auto/);
+  });
+
+  it("together, the session's save goes to filex with its reason", async () => {
+    const calls: { method: string; params: unknown; transfer: unknown[] }[] = [];
+    const fx = {
+      request: async (method: string, params: unknown, transfer: unknown[] = []) => {
+        calls.push({ method, params, transfer });
+        return { saved: true, size: 3 };
+      },
+      on: () => () => {},
+    } as unknown as FilexApp;
+    const bytes = new Uint8Array([1, 2, 3]).buffer;
+    await coeditApi(fx).save(bytes, 'application/x', 5, 'auto');
+    expect(calls).toEqual([{ method: 'file.save', params: { index: 0, data: bytes, mime: 'application/x', reason: 'auto', through: 5 }, transfer: [bytes] }]);
+  });
+});
+
+/** A save the test ends when it likes. */
+function writer() {
+  const made: SaveReason[] = [];
+  const open: { reason: SaveReason; end: (ok?: boolean) => void }[] = [];
+  const write = (reason: SaveReason) =>
+    new Promise<void>((resolve, reject) => {
+      made.push(reason);
+      open.push({ reason, end: (ok = true) => (ok ? resolve() : reject(new Error('refused'))) });
+    });
+  return { made, open, write };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+describe('one save at a time', () => {
+  it('a save asked for during one of the same kind is that one', async () => {
+    for (const reason of SAVE_REASONS) {
+      const w = writer();
+      const q = new SaveQueue(w.write);
+      const a = q.save(reason);
+      const b = q.save(reason);
+      expect(b).toBe(a);
+      await tick();
+      expect(q.busy).toBe(true);
+      expect(q.reason).toBe(reason);
+      w.open[0].end();
+      await a;
+      expect(w.made).toEqual([reason]);
+      expect(q.busy).toBe(false);
+      expect(q.reason).toBeNull();
+    }
+  });
+
+  it("an autosave due during the person's save is the person's save", async () => {
+    const w = writer();
+    const q = new SaveQueue(w.write);
+    const a = q.save('user');
+    expect(q.save('auto')).toBe(a);
+    await tick();
+    w.open[0].end();
+    await a;
+    expect(w.made).toEqual(['user']);
+  });
+
+  it("the person's save during an autosave is made after it, once, as theirs", async () => {
+    const w = writer();
+    const q = new SaveQueue(w.write);
+    const auto = q.save('auto');
+    const u1 = q.save('user');
+    const u2 = q.save('user');
+    expect(u2).toBe(u1);
+    await tick();
+    expect(w.made).toEqual(['auto']);
+    w.open[0].end();
+    await auto;
+    await tick();
+    expect(w.made).toEqual(['auto', 'user']);
+    expect(q.reason).toBe('user');
+    let done = false;
+    void u1.then(() => (done = true));
+    await tick();
