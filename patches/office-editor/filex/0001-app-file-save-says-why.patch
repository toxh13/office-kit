+/**
+ * Why a save is made, said to filex with it (`file.save`'s `reason`):
+ * `user` - the person asked for it (the editor's Save or Ctrl+S, filex's
+ * Save, a switch of view, the last writer leaving); `auto` - the ten-minute
+ * save while there are changes. filex writes both as a new version of the
+ * file and may ignore the word; a host that keeps an autosave apart from the
+ * file (a copy to recover from, not written over the file the person did
+ * not ask to save) tells the two apart by it.
+ */
+export type SaveReason = 'user' | 'auto';
+
+export const SAVE_REASONS: readonly SaveReason[] = ['user', 'auto'];
+
+/** `file.save`'s params: the document, its type, why it is saved and - together - how far into the session's log it reaches. */
+export interface SaveParams {
+  index: number;
+  data: ArrayBuffer;
+  mime: string;
+  reason: SaveReason;
+  through?: number;
+}
+
+export function saveParams(data: ArrayBuffer, mime: string, reason: SaveReason, through?: number): SaveParams {
+  if (!SAVE_REASONS.includes(reason)) throw new Error(`a save's reason is user or auto, not ${String(reason)}`);
+  return through === undefined ? { index: 0, data, mime, reason } : { index: 0, data, mime, reason, through };
+}
+
 /** The languages the app's own words come in. */
 export type UiLang = 'en' | 'tr';
 
